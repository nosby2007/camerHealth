# =============================================================================
# CameroHealth — MINSANTE — Fichier de configuration d'environnement
# =============================================================================
# INSTRUCTIONS :
#   1. Copiez ce fichier : cp .env.example .env.development (ou .env.production)
#   2. Remplissez CHAQUE variable avec vos propres valeurs
#   3. Ne committez JAMAIS votre fichier .env sur Git
#   4. Vérifiez que .env* est bien listé dans .gitignore
#
# ⚠️  SÉCURITÉ CRITIQUE :
#   - Aucune valeur par défaut n'est fournie intentionnellement.
#   - Si une variable est manquante, l'application lèvera une erreur explicite.
#   - Révoquez et régénérez immédiatement toute clé exposée dans le code source.
# =============================================================================


# -----------------------------------------------------------------------------
# 🌐 API Backend — MINSANTE Surveillance Service
# -----------------------------------------------------------------------------
# URL de base de l'API nationale de surveillance épidémiologique
# Exemple : https://api.minsante.gov.cm
API_URL=

# URL de l'endpoint des statistiques en temps réel
# Exemple : https://api.minsante.gov.cm/stats
STATUS_AXIOS_URL=


# -----------------------------------------------------------------------------
# 🔐 AWS Cognito — Identité nationale (couche Ministry)
# -----------------------------------------------------------------------------
# URL du serveur d'autorisation OAuth Cognito
# Exemple : https://camerohealth.auth.eu-west-1.amazoncognito.com/oauth2/token
AUTH_URL=

# Client ID de votre application Cognito (non sensible, peut être public)
# Trouvé dans : AWS Console → Cognito → User Pools → App Clients
CLIENT_ID=

# Client Secret de votre application Cognito
# ⚠️  SENSIBLE — ne jamais exposer côté client
# Trouvé dans : AWS Console → Cognito → User Pools → App Clients
CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 🗺  Google Maps Platform — Couche GIS
# -----------------------------------------------------------------------------
# Clé API Google Maps avec les APIs suivantes activées :
#   - Maps JavaScript API
#   - Geocoding API
# ⚠️  Restreindre cette clé aux domaines autorisés dans Google Cloud Console
# Exemple : AIzaSy...
VUE_APP_GOOGLE_MAPS_API_KEY=


# -----------------------------------------------------------------------------
# 🗄  Supabase — Base de données clinique & authentification
# -----------------------------------------------------------------------------
# URL de votre projet Supabase
# Trouvée dans : Supabase Dashboard → Settings → API → Project URL
# Exemple : https://xyzxyzxyz.supabase.co
SUPABASE_URL=

# Clé publique anonyme (anon/publishable key) — utilisée côté client
# ⚠️  Cette clé est publique PAR CONCEPTION mais les Row Level Security (RLS)
#     DOIVENT être activées sur toutes les tables pour sécuriser les données.
# Trouvée dans : Supabase Dashboard → Settings → API → anon public
SUPABASE_KEY=

# Bucket de stockage Supabase utilisé pour les documents et images cliniques
# Exemple : imaging-files
SUPABASE_STORAGE_BUCKET=

# Clé de service (service_role key) — UNIQUEMENT pour les scripts serveur/admin
# ⚠️  EXTRÊMEMENT SENSIBLE — contourne les RLS. Ne jamais exposer côté client.
# Trouvée dans : Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 🚩 Feature Flags — Transitional Auth Cutover
# -----------------------------------------------------------------------------
# Supabase Auth compatibility mode (Phase 8)
# false = keep existing prototype login flow (default, backward-compatible)
# true  = enable Supabase email/password login path on /login
ENABLE_SUPABASE_AUTH=false

# Secure staff invitation backend endpoint (Phase 10 scaffold)
# Leave empty until a backend/admin endpoint exists. Example: /api/admin/staff/invite
STAFF_INVITE_ENDPOINT=

# Secure facility bootstrap backend endpoint (Phase 11 scaffold)
# Example: /api/bootstrap/facility-admin
FACILITY_BOOTSTRAP_ENDPOINT=

# Rate limit strategy marker for backend hardening (Phase 12)
# memory = local/staging scaffold only
# redis  = recommended distributed production strategy
RATE_LIMIT_STRATEGY=memory