# ─── CameroHealth On-Premise — environment configuration ────────────────────
# Copy to .env and fill in. Never commit the real .env file.
# Run ./scripts/generate-secrets.sh to fill DB_PASSWORD, MINIO_PASSWORD and
# JWT_SECRET with strong random values instead of typing your own.

CAMEROHEALTH_VERSION=1.0.0
DEPLOYMENT_MODE=onprem
DATA_RESIDENCY=LOCAL
CLOUD_PATIENT_SYNC=false

# ── This hospital ────────────────────────────────────────────────────────────
HOSPITAL_ID=
HOSPITAL_NAME=
APP_ORIGIN=https://camerohealth.local
APP_TIMEZONE=Africa/Douala

# ── Ports exposed on the host (only Nginx binds to the host at all) ─────────
HTTP_PORT=80
HTTPS_PORT=443

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=camerohealth
DB_USER=camerohealth
DB_PASSWORD=

# ── MinIO (local file storage) ───────────────────────────────────────────────
MINIO_USER=
MINIO_PASSWORD=
MINIO_BUCKET=camerohealth

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=24h
AUTH_PROVIDER=local

# ── Backup ───────────────────────────────────────────────────────────────────
BACKUP_DIR=./backup
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# ── Telemetry (technical metadata only — never patient/clinical data; see
#    docs/onprem/ARCHITECTURE.md "Control plane preparation") ────────────────
TELEMETRY_ENABLED=false

# ── Optional integrations — leave blank to disable, no code change needed ───
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENV=sandbox
